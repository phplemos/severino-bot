generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id // Discord User ID
  username         String?
  displayName      String?
  avatar           String?
  isBot            Boolean   @default(false)

  // Server & Account Dates (Retroactive)
  joinedAt         DateTime? // Server join timestamp
  accountCreatedAt DateTime? // Discord account creation timestamp
  premiumSince     DateTime? // Server boost start date
  roles            String[]  @default([])
  isInServer       Boolean   @default(true)

  // Voice & Activity Tracking (Real-time accumulated)
  totalVoiceSeconds Int       @default(0)
  voiceJoinedAt    DateTime? // Session start time if currently in voice
  lastActiveAt     DateTime?
  activeDaysCount  Int       @default(0)
  lastActiveDayStr String?   // YYYY-MM-DD to track distinct active days

  // Existing Economy & Moderation fields
  coins            Int       @default(0)
  xp               Int       @default(0)
  level            Int       @default(1)
  lastDailyAt      DateTime?
  warnings         Warning[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Warning {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reason    String
  moderator String   // Moderator ID
  createdAt DateTime @default(now())
}

model HubChannel {
  id           String @id // Discord Channel ID
  guildId      String
  templateName String @default("🏠 {user}'s Room")
}

model GuildConfig {
  guildId          String  @id // Discord Guild ID
  prefix           String  @default("!")
  rankingChannelId String?
  rankingMessageId String?
}
