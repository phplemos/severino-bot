# Para rodar o bot fora do Docker (npm run dev). Em produção as variáveis vêm do docker-compose.yml do homelab.
# Bate com o Postgres descartável do README; em produção o bot usa o papel severino_app
DATABASE_URL="postgresql://severino:severino@localhost:5432/severino?schema=public"
DISCORD_TOKEN="SEU_TOKEN_DO_BOT"
GUILD_ID="ID_DO_SERVIDOR"
HUB_CHANNEL_ID=""
AUTO_SYNC_MEMBERS=true
HEALTH_PORT=8080
# Vazio usa o yt-dlp do PATH (a música também precisa do ffmpeg no PATH); o Docker define o seu
YTDLP_PATH=""
# true faz o yt-dlp sair só pelo IPv6; vazio usa a rede como ela vier (o Docker liga)
YTDLP_FORCE_IPV6=""
# Cache em disco da música; vazio desliga (o Docker usa /cache)
MUSIC_CACHE_DIR=""

# Só para npm run clear-cmds
CLIENT_ID="ID_DO_APLICATIVO"

# Só para os testes de banco (Postgres descartável com as migrações aplicadas)
TEST_DATABASE_URL=""
