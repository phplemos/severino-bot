# Para rodar o bot fora do Docker (npm run dev). Em produção as variáveis vêm do docker-compose.yml do homelab.
DATABASE_URL="postgresql://severino_app:senha@localhost:5432/severino?schema=public"
DISCORD_TOKEN="SEU_TOKEN_DO_BOT"
GUILD_ID="ID_DO_SERVIDOR"
HUB_CHANNEL_ID=""
AUTO_SYNC_MEMBERS=true
HEALTH_PORT=8080

# Só para npm run clear-cmds
CLIENT_ID="ID_DO_APLICATIVO"

# Só para os testes de banco (Postgres descartável com as migrações aplicadas)
TEST_DATABASE_URL=""
