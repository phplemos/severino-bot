{
  "name": "severino-discord-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Bot de gestão do servidor SDJ no Discord",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "clear-cmds": "tsx src/lib/clear-commands.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "discord",
    "bot",
    "sapphire",
    "prisma"
  ],
  "author": "phplemos",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@sapphire/framework": "5.5.0",
    "@sapphire/plugin-logger": "3.0.7",
    "discord.js": "14.27.0",
    "dotenv": "16.6.1",
    "prisma": "5.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
